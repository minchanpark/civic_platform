{
  "name": "civic-pin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types lib/*.test.ts app/api/issues/*.test.ts",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset --local",
    "test:db": "supabase test db --local supabase/tests",
    "lint:db": "supabase db lint --local --schema public,private --level warning --fail-on warning"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.3",
    "leaflet": "1.9.4",
    "next": "16.3.1",
    "nodemailer": "9.0.5",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/leaflet": "1.9.22",
    "@types/node": "22.20.1",
    "@types/nodemailer": "8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "supabase": "2.114.0",
    "typescript": "5.9.3"
  }
}
